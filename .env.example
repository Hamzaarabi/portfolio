# Supabase (browser-safe values only)
# The production build already contains public fallbacks for Hamza project.
# Use these variables to point a fork/preview at another Supabase project.
# Never put a Supabase secret/service_role key in a VITE_* variable.
VITE_SUPABASE_URL=https://edplthwtzxdrqitdupvi.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
VITE_ADMIN_EMAIL=arabihamzaaa@gmail.com

# Optional — EmailJS also has built-in public fallbacks and can now be edited
# from Admin → EmailJS after the Supabase database is seeded.
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxx
